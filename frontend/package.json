{
  "name": "campus-venue-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "format": "prettier --write src vite.config.ts index.html"
  },
  "dependencies": {
    "lucide-vue-next": "0.468.0",
    "vue": "3.5.44",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "^3.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
